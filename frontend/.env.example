# Salin ke .env.local untuk pengembangan lokal.
# Di Vercel, isi variabel ini lewat Project Settings -> Environment Variables.
#
# Lokal (backend jalan di komputer sendiri):
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
#
# Production (backend di Render), contoh:
# NEXT_PUBLIC_API_URL=https://laudry-api.onrender.com/api
